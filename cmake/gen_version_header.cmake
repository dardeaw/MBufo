if(NOT DEFINED SRC_DIR)
  set(SRC_DIR "${CMAKE_CURRENT_LIST_DIR}/..")
endif()
if(NOT DEFINED OUT_FILE)
  message(FATAL_ERROR "OUT_FILE must be defined")
endif()

execute_process(
  COMMAND git -C "${SRC_DIR}" rev-parse HEAD
  OUTPUT_VARIABLE GIT_COMMIT
  OUTPUT_STRIP_TRAILING_WHITESPACE
  ERROR_QUIET
  RESULT_VARIABLE RC_COMMIT
)
if(NOT RC_COMMIT EQUAL 0 OR GIT_COMMIT STREQUAL "")
  set(GIT_COMMIT "unknown")
endif()

execute_process(
  COMMAND git -C "${SRC_DIR}" rev-parse --short=8 HEAD
  OUTPUT_VARIABLE GIT_SHORT
  OUTPUT_STRIP_TRAILING_WHITESPACE
  ERROR_QUIET
  RESULT_VARIABLE RC_SHORT
)
if(NOT RC_SHORT EQUAL 0 OR GIT_SHORT STREQUAL "")
  set(GIT_SHORT "unknown")
endif()

execute_process(
  COMMAND git -C "${SRC_DIR}" describe --tags --abbrev=0
  OUTPUT_VARIABLE GIT_TAG
  OUTPUT_STRIP_TRAILING_WHITESPACE
  ERROR_QUIET
  RESULT_VARIABLE RC_TAG
)
if(NOT RC_TAG EQUAL 0 OR GIT_TAG STREQUAL "")
  set(GIT_TAG "v0.36.0")
endif()

string(TIMESTAMP BUILD_UTC "%Y-%m-%dT%H:%M:%SZ" UTC)

file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}")
get_filename_component(OUT_DIR "${OUT_FILE}" DIRECTORY)
file(MAKE_DIRECTORY "${OUT_DIR}")

set(TMP_FILE "${OUT_FILE}.tmp")
file(WRITE "${TMP_FILE}"
"// Auto-generated by cmake/gen_version_header.cmake. Do not edit.
#ifndef MBUFO_GENERATED_BUILD_VERSION_HPP_
#define MBUFO_GENERATED_BUILD_VERSION_HPP_

namespace mbufo::build {
inline constexpr const char* kGitCommit = \"${GIT_COMMIT}\";
inline constexpr const char* kGitShort = \"${GIT_SHORT}\";
inline constexpr const char* kGitTag = \"${GIT_TAG}\";
inline constexpr const char* kBuildTimeUtc = \"${BUILD_UTC}\";
}  // namespace mbufo::build

#endif  // MBUFO_GENERATED_BUILD_VERSION_HPP_
")

execute_process(
  COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${TMP_FILE}" "${OUT_FILE}"
)
file(REMOVE "${TMP_FILE}")
